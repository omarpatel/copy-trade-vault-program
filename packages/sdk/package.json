{
  "name": "@copy-trade-vault/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts"
  },
  "scripts": {
    "sync-idl": "node -e \"const fs=require('fs');fs.copyFileSync('../../target/idl/copy_vault.json','src/idl/copy_vault.json');fs.copyFileSync('../../target/types/copy_vault.ts','src/idl/copy_vault.ts')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
